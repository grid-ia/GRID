# GRID — local evaluation settings.
# Copy to `.env` (`cp .env.sample .env`). Defaults below run a free local trial.

# ---- Web ----
GRID_HTTP_PORT=8080

# ---- Local database (lives in a Docker volume; see docker-compose.yml) ----
# Password for the local database (used by both the db and backend services).
MYSQL_PASSWORD=grid-eval

# ---- Workflow engine ----
# `native` = GRID runs its own workflow engine; no extra container needed. Keep as-is.
GRID_WORKFLOW_MODE=native

# ---- AI assistant ----
# Out of the box the trial uses a small BUNDLED local model (no key, no internet, no cost).
# It is deliberately limited. For full answers, set your own provider below and the
# assistant uses it instead of the local model.
GRID_AI_LOCAL_FALLBACK=true
#
# Optional — your own LLM provider (e.g. an OpenAI-compatible endpoint):
# GRID_AI_PLATFORM_PROVIDER=openai
# GRID_AI_PLATFORM_MODEL=gpt-4o-mini
# GRID_AI_PLATFORM_API_KEY=sk-...

# ---- Licensing (optional) ----
# The evaluation build runs a capped trial with no licence at all. If you registered at
# alpha.grid.ia.br and generated a licence, put the downloaded `grid.license` file into a
# `license/` folder next to this file -- nothing to set here. GRID checks it with alpha's HTTPS
# certificate and renews it automatically before that certificate expires (keep the folder
# writable). Case creation then meters against your account's shared pool.
